@@ -672,6 +672,17 @@ static int start_transfers(const struct sr_dev_inst *sdi)
 
 	timeout = get_timeout(devc);
 	devc->num_transfers = num_transfers;
+
+#if defined(_WIN32) && defined(LIBUSB_API_VERSION) && (LIBUSB_API_VERSION >= 0x0100010C)
