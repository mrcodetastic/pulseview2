@@ -124,6 +133,59 @@ static gboolean usb_source_dispatch(GSource *source,
 
 	usource = (struct usb_source *)source;
 	revents = 0;
+
+	if (usource->no_pollfds) {
+		struct timeval tv;
+		int64_t now_us = g_get_monotonic_time();
+		int64_t wait_us = 10000; /* Cap wait at 10 ms so Stop stays snappy */
+		gboolean timed_out = FALSE;
+
+		if (usource->due_us == 0 && usource->timeout_us >= 0)
+			usource->due_us = now_us + usource->timeout_us;
+
+		if (usource->due_us != INT64_MAX) {
+			int64_t rem_us = usource->due_us - now_us;
+			if (rem_us <= 0)
+				wait_us = 0;
+			else if (rem_us < wait_us)
+				wait_us = rem_us;
+		}
+
+		tv.tv_sec = (long)(wait_us / G_USEC_PER_SEC);
+		tv.tv_usec = (long)(wait_us % G_USEC_PER_SEC);
+
+		libusb_handle_events_timeout_completed(usource->usb_ctx, &tv, NULL);
+
+		/* Transfer callbacks may have removed/destroyed this source. */
+		if (g_source_is_destroyed(source))
+			return G_SOURCE_REMOVE;
+
+		now_us = g_get_monotonic_time();
+		if (usource->due_us != INT64_MAX && now_us >= usource->due_us) {
+			timed_out = TRUE;
+			revents = 0;
+		} else {
+			revents = G_IO_IN;
+		}
+
+		if (!callback) {
+			sr_err("Callback not set, cannot dispatch event.");
+			return G_SOURCE_REMOVE;
+		}
+		keep = (*SR_RECEIVE_DATA_CALLBACK(callback))(-1, revents, user_data);
+
+		if (G_LIKELY(keep) && G_LIKELY(!g_source_is_destroyed(source))) {
+			if (timed_out) {
+				if (usource->timeout_us >= 0)
+					usource->due_us = g_get_monotonic_time()
+							+ usource->timeout_us;
+				else
+					usource->due_us = INT64_MAX;
+			}
+		}
+		return keep;
+	}
+
 	/*
 	 * This is somewhat arbitrary, but drivers use revents to distinguish
 	 * actual I/O from timeouts. When we remove the user timeout from the
@@ -160,7 +222,8 @@ static void usb_source_finalize(GSource *source)
 
 	sr_spew("%s", __func__);
 
