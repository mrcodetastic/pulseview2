+		if (max_raw > 0 && size <= (size_t)max_raw && (size % 512) == 0) {
+			if (libusb_endpoint_set_raw_io(usb->devhdl, 2 | LIBUSB_ENDPOINT_IN, 1) == LIBUSB_SUCCESS)
+				sr_dbg("Enabled WinUSB RAW_IO on bulk IN endpoint (transfer size %" G_GSIZE_FORMAT ").", size);
