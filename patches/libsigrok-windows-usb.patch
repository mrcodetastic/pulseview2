 	}
-	start_transfers(sdi);
+	if ((ret = start_transfers(sdi)) != SR_OK) {
+		if (devc->submitted_transfers == 0)
+			usb_source_remove(sdi->session, devc->ctx);
+		return ret;
+	}
 	if ((ret = command_start_acquisition(sdi)) != SR_OK) {
 		fx2lafw_abort_acquisition(devc);
 		return ret;
